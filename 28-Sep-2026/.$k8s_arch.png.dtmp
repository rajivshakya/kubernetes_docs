        <mxCell id="0UY9imRtixyRPeH5MvkT-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;rounded=0;fontStyle=1" value="ETCD" vertex="1">
