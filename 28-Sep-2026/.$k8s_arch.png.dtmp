        <mxCell id="0UY9imRtixyRPeH5MvkT-52" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;Kubelet is the primary agent on each worker node that communicates with the API Server, ensures Pods and containers are running as specified, and performs health checks using configured probes.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-53" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;Kube-proxy manages network rules on each node to enable communication between Kubernetes Services and their backend Pods.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-54" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;The Container Runtime is responsible for pulling container images and creating, starting, and managing containers on worker nodes.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-55" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;A Pod is the smallest deployable unit in Kubernetes that runs one or more containers sharing the same network namespace and, optionally, storage volumes.&lt;/p&gt;" vertex="1">
