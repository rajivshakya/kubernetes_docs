        <mxCell id="0UY9imRtixyRPeH5MvkT-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;The API Server processes API requests, performs authentication, authorization, admission control, and validation, and communicates with etcd to store and retrieve cluster state.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="620" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-40" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#b85450;fillColor=#f8cecc;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;A Controller continuously monitors the cluster&#39;s actual state and takes corrective actions to match it with the desired state.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="720" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-41" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;The Scheduler selects the most suitable node for a Pod based on resource availability, node labels and selectors, node affinity and anti-affinity, taints and tolerations, and other scheduling constraints.&lt;/p&gt;" vertex="1">
          <mxGeometry height="82" width="530" x="280" y="820" as="geometry" />
        </mxCell>
        <mxCell id="0UY9imRtixyRPeH5MvkT-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=middle;rounded=0;fontColor=#333333;fontStyle=1" value="&lt;p&gt;etcd is a distributed key-value store used to persist Kubernetes cluster data, including its configuration and state.&lt;/p&gt;" vertex="1">
